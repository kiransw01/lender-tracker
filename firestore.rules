rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone signed in (including anonymous) can read/write any user doc.
    // Your phone number is effectively your "password" — don't share your
    // phone number + this app's link publicly.
    match /users/{phone} {
      allow read, write: if request.auth != null;
    }
  }
}
